<% layout("/layouts/boilerplate.ejs")%>

<div class="row justify-content-center my-5">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4">
      <div class="mb-3">
        <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 3.5rem;"></i>
      </div>
      <h3 class="fw-bold mb-2">Oops! Something went wrong</h3>
      <p class="text-danger fw-semibold mb-3"><%= message %></p>
      <p class="text-muted small mb-4">The page or resource you are looking for might have been moved, removed, or is temporarily unavailable.</p>
      <div>
        <a href="/listings" class="btn btn-dark px-4 py-2 rounded-pill">
          <i class="fa-solid fa-house me-1"></i> Back to All Listings
        </a>
      </div>
    </div>
  </div>
</div>
