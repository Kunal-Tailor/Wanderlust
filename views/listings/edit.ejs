<% layout("/layouts/boilerplate.ejs")%>

<div class="row justify-content-center mt-3 mb-5">
  <div class="col-12 col-md-10 col-lg-8">

    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fw-bold mb-1">Edit Listing</h2>
        <p class="text-muted small mb-0">Update details for <%= listing.title %></p>
      </div>
      <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Back
      </a>
    </div>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
      
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input 
          id="title"
          name="listing[title]" 
          value="<%= listing.title %>" 
          type="text" 
          class="form-control" 
          required 
        />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter a title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea 
          id="description"
          name="listing[description]" 
          rows="4"
          class="form-control" 
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a description.</div>
      </div>
      
      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Image URL</label>
        <input 
          id="image"
          name="listing[image]" 
          value="<%= listing.image ? (listing.image.url || listing.image) : '' %>" 
          type="text" 
          class="form-control" 
          required
        />
        <div class="invalid-feedback">Please enter an image URL.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
          <input 
            id="price"
            name="listing[price]" 
            value="<%= listing.price %>" 
            type="number" 
            min="0"
            class="form-control" 
            required
          />
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
  
        <div class="mb-3 col-md-4">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input
            id="country"
            name="listing[country]"
            value="<%= listing.country %>"
            type="text" 
            class="form-control" 
            required
          />
          <div class="invalid-feedback">Please enter the country.</div>
        </div>

        <div class="mb-3 col-md-4">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select id="category" name="listing[category]" class="form-select">
            <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>Trending</option>
            <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>Rooms</option>
            <option value="Iconic Cities" <%= listing.category === 'Iconic Cities' ? 'selected' : '' %>>Iconic Cities</option>
            <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>Mountains</option>
            <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>Castles</option>
            <option value="Amazing Pools" <%= listing.category === 'Amazing Pools' ? 'selected' : '' %>>Amazing Pools</option>
            <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>Camping</option>
            <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>Farms</option>
            <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>Arctic</option>
            <option value="Beachfront" <%= listing.category === 'Beachfront' ? 'selected' : '' %>>Beachfront</option>
          </select>
        </div>
      </div>

      <div class="mb-4">
        <label for="location" class="form-label fw-semibold">Location / City</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text" 
          class="form-control" 
          required
        />
        <div class="invalid-feedback">Please enter the location.</div>
      </div>

      <div class="d-flex align-items-center gap-3 pt-2">
        <button type="submit" class="btn edit-btn px-4 py-2">
          <i class="fa-solid fa-check me-1"></i> Save Changes
        </button>
        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
      </div>

    </form>
  </div>
</div>
